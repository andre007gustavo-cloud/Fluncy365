# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha. NUNCA commite o .env.local.
# ---------------------------------------------------------------------------

# Supabase — Project Settings > API
# Publicas (vao para o navegador; protegidas por Row Level Security):
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole-aqui-a-anon-public-key"

# SECRETA — so no servidor. Ignora RLS. Nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="cole-aqui-a-service-role-key"

# Anthropic — usada apenas em /api/tutor (servidor). Entra em uso na Fase 2.
ANTHROPIC_API_KEY="sk-ant-..."

# URL publica do app (usada no redirect de login com Google)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
